# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Model bundles (downloaded separately — see scripts/download-model.sh)
models/
*.mlmodelc
*.mlpackage
*.mlmodel
*.bin

# Xcode
*.xcodeproj
*.xcworkspace
DerivedData/
xcuserdata/

# Local signing (per-developer team id; copy from Local.xcconfig.template)
Examples/DemoApp/Local.xcconfig

# The sample app ships a committed Xcode project so it opens straight after clone. Track that one
# project (re-include the directory before its contents), but never per-user state inside it.
!Examples/DemoApp/DemoApp.xcodeproj
!Examples/DemoApp/DemoApp.xcodeproj/**
Examples/DemoApp/DemoApp.xcodeproj/**/xcuserdata/

# macOS
.DS_Store

# Editor
*.swp
.vscode/
.idea/

# SourceKit-LSP build server config (generated by xcode-build-server; holds machine-local paths)
buildServer.json
